{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": "http://localhost:5173,http://127.0.0.1:5173"
  },
  "PythonEngine": {
    "BaseUrl": "http://localhost:8001",
    "TimeoutSeconds": 5
  },
  "Upload": {
    "MaxFileSizeBytes": 15728640,
    "AllowedContentTypes": "image/png,image/jpeg,image/webp"
  },
  "Storage": {
    "RootPath": "App_Data/uploads"
  },
  "ProjectRegistry": {
    "RootPath": "App_Data/projects"
  },
  "Preprocess": {
    "MinContrast": 0.5,
    "MaxContrast": 3.0,
    "MinBrightness": -100,
    "MaxBrightness": 100,
    "MinDenoise": 0,
    "MaxDenoise": 10,
    "TimeoutSeconds": 20
  },
  "Threshold": {
    "MinValue": 0,
    "MaxValue": 255,
    "NearEmptyMaxForegroundPercent": 2.0,
    "NearFullMinForegroundPercent": 98.0,
    "TimeoutSeconds": 20
  },
  "ThresholdRegistry": {
    "RootPath": "App_Data/thresholds"
  },
  "Vectorize": {
    "TimeoutSeconds": 30
  },
  "VectorRegistry": {
    "RootPath": "App_Data/vectors"
  }
}
