<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.AspNetCore.OpenApi (nativo de .NET 9) es incompatible en runtime con
         Microsoft.OpenApi 2.x que trae Swashbuckle.AspNetCore >= 7, así que se usa
         únicamente Swashbuckle para generar el documento OpenAPI y servir Swagger UI. -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

</Project>
