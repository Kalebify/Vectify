# Variables usadas por docker-compose.yml para levantar React + ASP.NET Core + FastAPI.
# Copiar a ".env" en la raíz del repo para personalizar puertos/URLs. Ningún
# valor de este archivo es secreto real.

# ---- Puertos publicados en el host ----
FRONTEND_PORT=5173
BACKEND_PORT=5080
PYTHON_PORT=8001

# ---- Frontend (React) ----
# URL que usa el NAVEGADOR para llamar a la Web API. Debe apuntar al puerto
# publicado en el host (BACKEND_PORT), no a un nombre de servicio de Docker.
VITE_API_BASE_URL=http://localhost:5080

# ---- Backend (ASP.NET Core) ----
ASPNETCORE_ENVIRONMENT=Development
# URL interna (dentro de la red de docker-compose) hacia el motor Python.
PYTHON_ENGINE_INTERNAL_URL=http://python-engine:8000
PYTHON_ENGINE_TIMEOUT_SECONDS=5

# ---- Motor Python (FastAPI) ----
SERVICE_NAME=vectify-python-engine
SERVICE_VERSION=0.1.0
LOG_LEVEL=info
